{
  "name": "sulyap",
  "private": true,
  "version": "0.2.0",
  "description": "Sulyap: A Provincial Tourism Office-Supported Web Platform for Discovering Lesser-Known Tourist Destinations in Pampanga",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "lint": "eslint client server",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"server/**/*.{js,sql}\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx,css}\" \"server/**/*.js\"",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:seed:demo": "npm run db:seed:demo -w server",
    "db:clear:demo": "npm run db:clear:demo -w server",
    "db:check": "npm run db:check -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  },
  "type": "module"
}
