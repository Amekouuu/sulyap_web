# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Front-end address(es) allowed to call the API, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL on Supabase) ---
# Supabase dashboard > Connect > "Session pooler" connection string, with your password filled in.
DATABASE_URL=
# Leave as true for Supabase. Set to false only for a local PostgreSQL without SSL.
DATABASE_SSL=true
# Optional: path to the Supabase CA certificate (Database settings > SSL) for full certificate checks.
DATABASE_CA_CERT=

# --- Seeding ---
# Initial password for the seeded admin and officer accounts (at least 12 characters).
SEED_STAFF_PASSWORD=
# Password for the test-only demo accounts (npm run db:seed:demo).
SEED_DEMO_PASSWORD=

# --- Added in later phases ---
# JWT_SECRET=                 Phase B1: login sessions
# SUPABASE_URL=               Phase B1: photo and ID storage
# SUPABASE_SERVICE_ROLE_KEY=  Phase B1: photo and ID storage (server only, never in the client)
# APP_URL=                    Phase B1: links inside e-mails
# SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASS= MAIL_FROM=   Phase B1/B7: e-mail
