# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Front-end address(es) allowed to call the API, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL on Supabase) ---
# Supabase dashboard > Connect > "Session pooler" connection string, with your password filled in.
DATABASE_URL=
# Leave as true for Supabase. Set to false only for a local PostgreSQL without SSL.
DATABASE_SSL=true
# Optional: path to the Supabase CA certificate (Database settings > SSL) for full certificate checks.
DATABASE_CA_CERT=

# --- Seeding ---
# Initial password for the seeded admin and officer accounts (at least 12 characters).
SEED_STAFF_PASSWORD=
# Password for the test-only demo accounts (npm run db:seed:demo).
SEED_DEMO_PASSWORD=

# --- Login sessions and links (Phase B1) ---
# Long random secret that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Website address used in e-mail links.
APP_URL=http://localhost:5173

# --- Supabase Storage (Phase B1: ID photos; Phase B3: destination photos) ---
SUPABASE_URL=
# The secret key (server only, never in the client).
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail (leave SMTP_HOST empty in development: e-mails go to the dev outbox) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sulyap <no-reply@sulyap.site>

# --- Background jobs ---
# Secret an outside scheduler sends to POST /api/internal/jobs/id-cleanup (x-cron-secret header).
CRON_SECRET=

# --- Development only ---
# true = the login page shows quick sign-in buttons for seeded test accounts. Ignored in production.
ENABLE_DEV_LOGIN=false
